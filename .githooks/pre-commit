#!/bin/sh
# privacy-guard pre-commit — fast local warning before data enters history.
# Bypassable with `git commit --no-verify`; the CI workflow is the real backstop.
root="$(git rev-parse --show-toplevel)"
scan="$root/.privacy-guard/scan.mjs"
cfg="$root/.privacy-guard/patterns.json"

# mode-guard: docs are never executable. Sessions on Windows/NTFS mounts can set the
# exec bit on every file they write; core.fileMode=false hides that locally, so check
# the index directly. Cheap, so it runs before the scan.
exec_docs=$(git ls-files --stage -- '*.md' '*.json' | grep '^100755' | cut -f2)
if [ -n "$exec_docs" ]; then
  echo "mode-guard: commit blocked — these docs are marked executable (100755):"
  echo "$exec_docs" | sed 's/^/  • /'
  echo "  fix: git update-index --chmod=-x <file>   (then re-commit)"
  exit 1
fi

[ -f "$scan" ] || exit 0   # guard not installed here
if ! node "$scan" scan --staged --config "$cfg"; then
  echo ""
  echo "privacy-guard: commit blocked — personal/confidential/secret data in staged changes (above)."
  echo "  • fix it, or"
  echo "  • allowlist a legit match in .privacy-guard/patterns.json, or"
  echo "  • run the pre-publish-privacy-guard scrub workflow, then re-stage."
  echo "  • override this one commit only: git commit --no-verify"
  exit 1
fi
